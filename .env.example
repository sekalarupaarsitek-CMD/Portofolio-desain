# ============================================================================
# SEKALARUPA STUDIO - Environment Variables
# PRD Reference: Section 17.2 (Environment Configuration)
# ============================================================================

# Server Port
PORT=5000

# JSON Web Token Secret for Admin Authentication
JWT_SECRET=sekalarupa-studio-architecture-jwt-secret-key-2026

# Site Public URL
SITE_URL=http://localhost:5000

# Supabase PostgreSQL Configuration (for Production Cloud Deployment)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Production PostgreSQL Database URL (Optional if using direct connection)
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
